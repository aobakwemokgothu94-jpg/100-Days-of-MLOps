import mlflow
import mlflow.sklearn
from sklearn.datasets import make_classification
from sklearn.linear_model import LogisticRegression

# Step 1: Configure MLflow tracking server connection
mlflow.set_tracking_uri("http://localhost:5000")

# Step 2: Set or create the target experiment
mlflow.set_experiment("autolog-demo")

# Step 3: Enable MLflow autologging for scikit-learn
mlflow.autolog()

# Step 4: Create synthetic dataset
X, y = make_classification(n_samples=100, n_features=4, random_state=42)

# Step 5: Fit model (autologging automatically records parameters, metrics, and artifacts)
model = LogisticRegression(C=1.0, max_iter=100, solver="lbfgs")
model.fit(X, y)

print("Training run completed successfully.")

