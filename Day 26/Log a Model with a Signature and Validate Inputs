import numpy as np
import pandas as pd
import mlflow
import mlflow.sklearn
from mlflow.models import infer_signature
from sklearn.dummy import DummyClassifier

# 1. Connect to MLflow Tracking Server
mlflow.set_tracking_uri("http://localhost:5000")

# 2. Prepare synthetic dataset
X = pd.DataFrame({
    'amount': [10.5, 200.0, 50.0, 300.0, 15.0, 500.0],
    'num_txn': [1, 5, 2, 8, 1, 10]
})
y = np.array([0, 1, 0, 1, 0, 1])

# 3. Fit dummy model & generate predictions
model = DummyClassifier(strategy="most_frequent")
model.fit(X, y)
preds = model.predict(X)

# 4. Set MLflow experiment
mlflow.set_experiment("fraud-signature")

with mlflow.start_run():
    # TODO 1: Infer model signature
    signature = infer_signature(X, preds)

    # TODO 2: Log model with signature and input_example
    mlflow.sklearn.log_model(
        model,
        name="model",
        signature=signature,
        input_example=X
    )

print("model logged to the fraud-signature experiment")

