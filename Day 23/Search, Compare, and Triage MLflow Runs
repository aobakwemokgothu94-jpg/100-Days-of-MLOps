#!/usr/bin/env python3
"""
MLflow Run Triaging Script for fraud-detection Experiment

Rules:
1. Shortlist: Single best run with metrics.f1_score > 0.85 (highest f1_score) -> review-status=shortlisted
2. Reject: All runs with metrics.f1_score < 0.75 -> review-status=rejected
3. Untagged: All other runs (0.75 <= f1_score <= 0.85 and second-best candidate) carry no review-status tag.
"""

import mlflow
from mlflow.tracking import MlflowClient


def triage_experiment_runs(
    experiment_name: str = "fraud-detection",
    tracking_uri: str = "http://127.0.0.1:5000",
):
    # Set tracking server location
    mlflow.set_tracking_uri(tracking_uri)
    client = MlflowClient()

    # Get experiment
    exp = client.get_experiment_by_name(experiment_name)
    if not exp:
        exps = client.search_experiments()
        exp = next((e for e in exps if e.name == experiment_name), None)

    if not exp:
        raise ValueError(f"Experiment '{experiment_name}' not found.")

    exp_id = exp.experiment_id
    runs = client.search_runs(experiment_ids=[exp_id])
    print(
        f"Fetched {len(runs)} total runs for experiment '{experiment_name}'."
    )

    # Step 1: Clear existing 'review-status' tags across all runs
    for run in runs:
        if "review-status" in run.data.tags:
            client.delete_tag(run.info.run_id, "review-status")

    # Step 2: Identify shortlist candidates (f1_score > 0.85)
    shortlist_candidates = [
        r for r in runs if r.data.metrics.get("f1_score", 0) > 0.85
    ]

    if shortlist_candidates:
        best_run = max(
            shortlist_candidates, key=lambda r: r.data.metrics.get("f1_score", 0)
        )
        client.set_tag(best_run.info.run_id, "review-status", "shortlisted")
        print(
            f"Tagged run {best_run.info.run_id} as 'shortlisted' (f1_score: {best_run.data.metrics.get('f1_score')})"
        )

    # Step 3: Identify and tag underperformers (f1_score < 0.75)
    rejected_count = 0
    for run in runs:
        f1 = run.data.metrics.get("f1_score", 0)
        if f1 < 0.75:
            client.set_tag(run.info.run_id, "review-status", "rejected")
            rejected_count += 1

    print(f"Tagged {rejected_count} runs as 'rejected'.")

    # Step 4: Verification summary
    updated_runs = client.search_runs(experiment_ids=[exp_id])
    shortlisted = [
        r for r in updated_runs if r.data.tags.get("review-status") == "shortlisted"
    ]
    rejected = [
        r for r in updated_runs if r.data.tags.get("review-status") == "rejected"
    ]
    untagged = [r for r in updated_runs if "review-status" not in r.data.tags]

    print("\n--- Summary ---")
    print(f"Shortlisted : {len(shortlisted)}")
    print(f"Rejected    : {len(rejected)}")
    print(f"Untagged    : {len(untagged)}")


if __name__ == "__main__":
    triage_experiment_runs()
