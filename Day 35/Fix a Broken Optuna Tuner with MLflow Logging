## Verification

Run the following command to verify the experiment and saved configuration:

```bash
python - <<'PY'
import mlflow
import yaml

mlflow.set_tracking_uri("http://localhost:5000")
client = mlflow.tracking.MlflowClient()

experiment = client.get_experiment_by_name("hyperopt-tuning")
assert experiment is not None, "Experiment not found"

runs = client.search_runs(
    [experiment.experiment_id],
    max_results=1000
)

valid_runs = [
    run for run in runs
    if "n_estimators" in run.data.params
    and "max_depth" in run.data.params
    and "f1_score" in run.data.metrics
]

assert len(valid_runs) >= 20, "Fewer than 20 valid runs"

best_run = max(
    valid_runs,
    key=lambda run: run.data.metrics["f1_score"]
)

with open("configs/best_params.yaml") as f:
    saved_params = yaml.safe_load(f)

expected_params = {
    "n_estimators": int(best_run.data.params["n_estimators"]),
    "max_depth": int(best_run.data.params["max_depth"])
}

assert saved_params == expected_params, (
    "Saved YAML does not match the highest-F1 run"
)

print("Valid MLflow runs:", len(valid_runs))
print("Highest F1:", best_run.data.metrics["f1_score"])
print("Best parameters:", expected_params)
print("SUCCESS: MLflow runs and best configuration verified.")
PY
```

