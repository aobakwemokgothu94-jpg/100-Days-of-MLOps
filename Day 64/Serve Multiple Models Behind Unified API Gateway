Configuration Files
1. docker-compose.yml
Orchestrates the build and deployment of all three Python microservices alongside the Nginx reverse proxy.

YAML
version: '3.8'

services:
  fraud:
    build: ./fraud
    container_name: mm-fraud
    restart: always
    expose:
      - "5000"

  churn:
    build: ./churn
    container_name: mm-churn
    restart: always
    expose:
      - "5000"

  recommend:
    build: ./recommend
    container_name: mm-recommend
    restart: always
    expose:
      - "5000"

  nginx:
    image: nginx:alpine
    container_name: mm-nginx
    restart: always
    ports:
      - "8085:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - fraud
      - churn
      - recommend
2. nginx.conf
Configures upstream load balancing and path-based routing rules to direct incoming requests to the proper backend container.

Nginx
upstream fraud {
    server fraud:5000;
}

upstream churn {
    server churn:5000;
}

upstream recommend {
    server recommend:5000;
}

server {
    listen 80;

    location /fraud/ {
        proxy_pass http://fraud/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /churn/ {
        proxy_pass http://churn/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /recommend/ {
        proxy_pass http://recommend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
