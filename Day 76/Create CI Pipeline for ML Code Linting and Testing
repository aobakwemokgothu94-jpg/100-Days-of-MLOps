3. End-to-End Automation & API Verification Script (verify_ci_pipeline.py)
Python
import base64
import json
import urllib.request
import yaml

AUTH = base64.b64encode(b"gitea-admin:gitea2026").decode()
HEADERS = {"Authorization": f"Basic {AUTH}", "Content-Type": "application/json"}
BASE_URL = "http://localhost:3000/api/v1"


def api(path: str, method: str = "GET", body: bytes | None = None) -> dict:
    req = urllib.request.Request(
        f"{BASE_URL}{path}", data=body, headers=HEADERS, method=method
    )
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read().decode())


# 1. Validate workflow YAML structure on add-ci
with open(".gitea/workflows/ci.yml", encoding="utf-8") as f:
    wf = yaml.safe_load(f)
print("1. YAML jobs on add-ci:", list(wf.get("jobs", {}).keys()))

# 2. Verify PR #1 metadata
pr = api("/repos/gitea-admin/fraud-detector/pulls/1")
sha = pr["head"]["sha"]
print(
    f"2. PR #1: head={pr['head']['ref']} -> base={pr['base']['ref']} "
    f"| state={pr['state']} | merged={pr['merged']}"
)

# 3. Verify head commit combined status
status = api(f"/repos/gitea-admin/fraud-detector/commits/{sha}/status")
print(f"3. Commit {sha[:7]} combined status: {status.get('state')}")

# 4. Merge if approved and not yet merged
if status.get("state") == "success" and not pr["merged"]:
    api(
        "/repos/gitea-admin/fraud-detector/pulls/1/merge",
        method="POST",
        body=b'{"Do":"merge"}',
    )
    pr = api("/repos/gitea-admin/fraud-detector/pulls/1")
    print(f"4. Merged PR #1 -> merged={pr['merged']} | state={pr['state']}")
