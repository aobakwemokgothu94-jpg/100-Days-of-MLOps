3. app.py
The Flask application that continuously generates and updates live fraud-detection model metrics.

Python
import time
import threading
import random
from flask import Flask, Response
from prometheus_client import Counter, Gauge, generate_latest, CONTENT_TYPE_LATEST

app = Flask(__name__)

# Define Prometheus metrics
REQUEST_COUNT = Counter('flask_http_request_total', 'Total HTTP Requests', ['version'])
PREDICTION_ACCURACY = Gauge('prediction_accuracy', 'Current accuracy of the fraud model')
DATA_DRIFT_SCORE = Gauge('data_drift_score', 'Data drift score per feature column', ['column'])
INFERENCE_DURATION = Gauge('model_inference_duration_seconds', 'Model inference duration in seconds')

def background_metrics_updater():
    """Background thread to update metrics every 5 seconds for real motion."""
    while True:
        # Simulate accuracy fluctuation between 85% and 98%
        PREDICTION_ACCURACY.set(round(random.uniform(0.85, 0.98), 4))
        
        # Simulate inference duration between 15ms and 45ms
        INFERENCE_DURATION.set(round(random.uniform(0.015, 0.045), 4))
        
        # Simulate feature data drift scores
        for col in ['transaction_amount', 'user_age', 'device_risk_score']:
            DATA_DRIFT_SCORE.labels(column=col).set(round(random.uniform(0.01, 0.15), 4))
            
        # Increment request counters
        REQUEST_COUNT.labels(version='v1.2').inc(random.randint(1, 5))
        
        time.sleep(5)

@app.route('/metrics')
def metrics():
    return Response(generate_latest(), mimetype=CONTENT_TYPE_LATEST)

if __name__ == '__main__':
    # Start background metric generator thread
    t = threading.Thread(target=background_metrics_updater, daemon=True)
    t.start()
    
    app.run(host='0.0.0.0', port=5000)
