Code Scripts & Configuration Files
1. docker-compose.yml
Defines the multi-container Docker stack for the metric emitter, Prometheus, and Grafana.

YAML
version: '3.8'

services:
  metric-emitter:
    build: .
    container_name: metric-emitter
    ports:
      - "5000:5000"
    networks:
      - monitoring-net

  prometheus:
    image: prom/prometheus:latest
    container_name: mon-prometheus
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
    ports:
      - "9090:9090"
    networks:
      - monitoring-net

  grafana:
    image: grafana/grafana:latest
    container_name: mon-grafana
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=grafana2026
    networks:
      - monitoring-net

networks:
  monitoring-net:
    driver: bridge
