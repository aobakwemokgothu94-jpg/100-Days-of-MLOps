Implementation (promote.py)
Python
from mlflow import MlflowClient

TRACKING_URI = "http://localhost:5000"
MODEL = "fraud-detector"
PROD_ALIAS = "production"
CHALLENGER_VERSION = "2"

client = MlflowClient(tracking_uri=TRACKING_URI)


def f1_of(version: str) -> float:
    mv = client.get_model_version(MODEL, version)
    return client.get_run(mv.run_id).data.metrics["f1_score"]


def main() -> None:
    champ = client.get_model_version_by_alias(MODEL, PROD_ALIAS)
    c_f1 = f1_of(champ.version)
    x_f1 = f1_of(CHALLENGER_VERSION)
    if x_f1 > c_f1:
        client.set_registered_model_alias(MODEL, PROD_ALIAS, CHALLENGER_VERSION)
        print(f"Promoted v{CHALLENGER_VERSION} ({x_f1} > {c_f1})")
    else:
        print(f"Rejected v{CHALLENGER_VERSION} ({x_f1} <= {c_f1})")


if __name__ == "__main__":
    main()
